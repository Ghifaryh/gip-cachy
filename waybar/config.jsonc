{
  "layer": "top",
  "position": "top",
  "height": 20,
  "margin-top": 2,
  "margin-left": 4,
  "margin-right": 4,
  "margin-bottom": 0,
  "spacing": 4,

  "modules-left": [
    "custom/mysvg",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock",
    "custom/notification"
  ],
  "modules-right": [
    "group/media",
    "group/stats"
  ],

  "group/stats": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "bluetooth",
      "memory",
      "tray",
      "battery"
    ]
  },

  "group/media": {
    "orientation": "horizontal",
    "modules": [
      "mpris"
    ]
  },

  "custom/logo": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout"
  },

  "custom/mysvg": {
    "format": "  ",
    "on-click": "wlogout",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "sort-by-number": true,
    "all-outputs": true
  },

  "clock": {
    "format": "{:%H:%M | %A %d}",
    "tooltip-format": "<tt><span size='11pt'>{calendar}</span></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "days": "<span color='#a6adc8'><b>{}</b></span>",
        "weeks": "<span color='#94e2d5'><b>W{}</b></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode"
    }
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰖪 Disconnected",
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "Signal: {signalStrength}% ({signaldBm} dBm)\nFrequency: {frequency}MHz\nSSID: {essid}",
    "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/.config/hypr/scripts/launch-wifi",
    "max-length": 30
  },

  "bluetooth": {
    "format": " {status}",
    "format-disabled": "󰂲 Off",
    "format-connected": " {device_alias}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}\t({device_battery_percentage}%)",
    "on-click": "~/.config/hypr/scripts/launch-bluetooth",
    "on-click-right": "rfkill toggle bluetooth"
  },

  "memory": {
    "interval": 5,
    "format": "<span foreground='#cba6f7'>󰍛 {percentage}%</span>  <span foreground='#f5e0dc'>󰾆 {swapPercentage}%</span>",
    "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB ({swapPercentage}%)"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10
  },

  "battery": {
    "states": {
      "health": 80,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-health": "󰥔 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}\nPower draw: {power}W"
  },
  
"mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} <i>{title}</i>",
    "player-icons": {
      "default": "󰎈",
      "spotify": "󰓇",
      "firefox": "󰈹",
      "brave": "󰖟"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "max-length": 25,
    "interval": 1,
    "ellipsis": "…",
    "tooltip-format": "{player}: {title} - {artist} ({album})",
    "tooltip-format-firefox": "YouTube/Web: {title} - {artist}",
    "tooltip-format-brave": "YouTube/Web: {title} - {artist}"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "󱅫",
      "none": "",
      "dnd-notification": "󰂛",
      "dnd-none": "",
      "inhibited-notification": "󱅫",
      "inhibited-none": "",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec": "swaync-client -s | stdbuf -oL jq --unbuffered --compact-output '{text: (if .count > 0 then (.count|tostring) else \"\" end), alt: (if .dnd then \"dnd-\" else \"\" end + if .inhibited then \"inhibited-\" else \"\" end + if .count > 0 then \"notification\" else \"none\" end), tooltip: \"Notifications\", class: [(if .count > 0 then \"has-notifications\" else \"none\" end)]}'",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
