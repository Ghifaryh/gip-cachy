{
  "layer": "top",
  "position": "top",
  "height": 20,
  "margin-top": 2,
  "margin-left": 4,
  "margin-right": 4,
  "margin-bottom": 0,
  "spacing": 4,

  "modules-left": [
    "custom/mysvg",
    "hyprland/workspaces"
  ],
  "modules-center": [
    // "clock",
    "group/clock",
    "custom/notification"

  ],
  "modules-right": [
    "mpris",
    // "group/media",
    "group/stats"
  ],

  "group/stats": {
    "orientation": "horizontal",
    "modules": [
      "custom/vpn",
      // "custom/tailscale",
      "network",
      "bluetooth",
      "memory",
      "tray",
      "battery"
    ]
  },

  "group/media": {
    "orientation": "horizontal",
    "modules": [
      "mpris"
    ]
  },

  "group/clock": {
    "orientation": "horizontal",
    "modules": [
      "clock#time",
      "custom/separator",
      "clock#date"
    ]
  },

  "custom/logo": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout"
  },

  "custom/mysvg": {
    "format": "  ",
    "on-click": "wlogout",
    "tooltip": false
  },

  "custom/tailscale": {
    "format": "{}",
    "return-type": "json",
    "interval": 3,
    "exec": "~/.config/hypr/scripts/tailscale-status",
    "on-click": "sudo tailscale up --exit-node=gip-wrk-aio --exit-node-allow-lan-access --accept-routes && pkill -RTMIN+8 waybar",
    "on-click-right": "sudo tailscale up --reset && pkill -RTMIN+8 waybar",

    "signal": 8
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "sort-by-number": true,
    "all-outputs": true
  },

  "clock": {
    "format": "{:%H:%M | %A %d}",
    "tooltip-format": "<tt><span size='11pt'>{calendar}</span></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "days": "<span color='#a6adc8'><b>{}</b></span>",
        "weeks": "<span color='#94e2d5'><b>W{}</b></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode"
    }
  },

  "clock#time": {
    "format": "{:%H:%M}",
    "tooltip-format": "<tt><span size='11pt'>{calendar}</span></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<b>{}</b>",
        "days": "<b>{}</b>",
        "weeks": "<b>W{}</b>",
        "weekdays": "<b>{}</b>",
        "today": "<b><u>{}</u></b>"
      }
    },
    "actions": {
      "on-click-right": "mode"
    }
  },

  "custom/separator": {
    "format": "|",
    "tooltip": false
  },

  "clock#date": {
    "format": "{:%A %d}",
    "tooltip-format": "<tt><span size='11pt'>{calendar}</span></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<b>{}</b>",
        "days": "<b>{}</b>",
        "weeks": "<b>W{}</b>",
        "weekdays": "<b>{}</b>",
        "today": "<b><u>{}</u></b>"
      }
    },
    "actions": {
      "on-click-right": "mode"
    }
  },

  "network": {
    "interval": 2,
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-linked": "󰈀  {ifname} (No IP)",
    "format-disconnected": "󰖪  Disconnected",
    "format-icons": [
      "󰤯", // 0-20%
      "󰤟", // 20-40%
      "󰤢", // 40-60%
      "󰤥", // 60-80%
      "󰤨"  // 80-100%
    ],
    "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}% ({signaldBm} dBm)\nFreq: {frequency} MHz\nSpeed: ⇣ {bandwidthDownBytes} | ⇡ {bandwidthUpBytes}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
    "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nSpeed: ⇣ {bandwidthDownBytes} | ⇡ {bandwidthUpBytes}\nGateway: {gwaddr}",
    "tooltip-format-disconnected": "󰖪  No Network Connection",
    "on-click": "~/.config/hypr/scripts/launch-wifi",
    "max-length": 25
  },

  "bluetooth": {
    "format": " {status}",
    // "format-disabled": "󰂲 Off",
    "format-disabled": "󰂲",
    // "format-connected": " {device_alias}",
    "format-connected": "",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}\t({device_battery_percentage}%)",
    "on-click": "~/.config/hypr/scripts/launch-bluetooth",
    "on-click-right": "rfkill toggle bluetooth"
  },

  "memory": {
    "interval": 5,
    // "format": "<span foreground='#cba6f7'>󰍛 {percentage}%</span> <span foreground=c#f5e0dc'>󰾆 {swapPercentage}%</span>",
    // "format": "󰘚 {percentage}%<span color='#585b70'> </span>󰓡 {swapPercentage}%",
    // "format": "<span size='75%' foreground='#cba6f7'>󰘚 {percentage}%</span>\n<span size='75%' foreground='#f5e0dc'>󰓡 {swapPercentage}%</span>",

    // "format": "<span size='70%' color='#cba6f7'>󰘚 {percentage}%</span>\n<span size='70%' color='#f5e0dc' rise='2000'>󰓡 {swapPercentage}%</span>",
    "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB ({swapPercentage}%)"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10
  },

  "battery": {
    "states": {
      "health": 80,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-health": "󰥔 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}\nPower draw: {power}W"
  },
  
  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} <i>{title}</i>",
    "hide-empty-text": true,
    "player-icons": {
      "default": "󰎈",
      "spotify": "󰓇",
      "firefox": "󰈹",
      "brave": "󰖟"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "max-length": 25,
    "interval": 1,
    "ellipsis": "…",
    "tooltip-format": "{player}: {title} - {artist} ({album})",
    "tooltip-format-firefox": "YouTube/Web: {title} - {artist}",
    "tooltip-format-brave": "YouTube/Web: {title} - {artist}"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "󱅫",
      "none": "",
      "dnd-notification": "󰂛",
      "dnd-none": "",
      "inhibited-notification": "󱅫",
      "inhibited-none": "",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec": "swaync-client -s | stdbuf -oL jq --unbuffered --compact-output '{text: (if .count > 0 then (.count|tostring) else \"\" end), alt: (if .dnd then \"dnd-\" else \"\" end + if .inhibited then \"inhibited-\" else \"\" end + if .count > 0 then \"notification\" else \"none\" end), tooltip: \"Notifications\", class: [(if .count > 0 then \"has-notifications\" else \"none\" end)]}'",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/vpn": {
    "format": "{}",
    "return-type": "json",
    "interval": 3,
    "exec": "/home/gip/.config/hypr/scripts/vpn-status.sh",
    "signal": 8,
    "menu": "on-click",
    "menu-file": "/home/gip/.config/waybar/vpn_menu.xml",
    "menu-actions": {
        "forti_toggle": "/home/gip/.config/hypr/scripts/vpn-forti-toggle.sh",
        "ts_toggle": "/home/gip/.config/hypr/scripts/vpn-control.sh ts-toggle",
        "ts_aio": "/home/gip/.config/hypr/scripts/vpn-control.sh ts-aio",
        "ts_sandbox": "/home/gip/.config/hypr/scripts/vpn-control.sh ts-sandbox",
        "ts_direct": "/home/gip/.config/hypr/scripts/vpn-control.sh ts-direct",
        "disconnect_all": "/home/gip/.config/hypr/scripts/vpn-control.sh disconnect-all"
    }
  }

}
