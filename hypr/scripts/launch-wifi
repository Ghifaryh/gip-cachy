#!/bin/bash
CLASS="impala-float"

# 1. Toggle off if already running
if pgrep -f "kitty --class=$CLASS" >/dev/null; then
  pkill -f "kitty --class=$CLASS"
  exit 0
fi

# 2. Launch TUI in background
kitty --class="$CLASS" -e impala &

# 3. Wait for client to exist
while [ -z "$(hyprctl clients -j | jq -r ".[] | select(.class == \"$CLASS\")")" ]; do
  sleep 0.05
done

addr=$(hyprctl clients -j | jq -r ".[] | select(.class == \"$CLASS\") | .address")
hyprctl dispatch focuswindow address:$addr

# 4. Grace period before boundary loop kicks in
sleep 0.3

# 5. Boundary Check Loop
while true; do
  win_data=$(hyprctl clients -j | jq -r ".[] | select(.address == \"$addr\")")
  if [ -z "$win_data" ]; then break; fi

  x=$(echo "$win_data" | jq '.at[0]')
  y=$(echo "$win_data" | jq '.at[1]')
  w=$(echo "$win_data" | jq '.size[0]')
  h=$(echo "$win_data" | jq '.size[1]')

  cursor=$(hyprctl cursorpos)
  cx=$(echo "$cursor" | cut -d',' -f1 | tr -d ' ')
  cy=$(echo "$cursor" | cut -d',' -f2 | tr -d ' ')

  if ((cx < x || cx > (x + w) || cy < y || cy > (y + h))); then
    hyprctl dispatch closewindow address:$addr
    break
  fi
  sleep 0.2
done
