#!/usr/bin/env bash
CLASS="impala-float"

# 1. Toggle off if already running
if pgrep -f "kitty --class=$CLASS" >/dev/null; then
  pkill -f "kitty --class=$CLASS"
  exit 0
fi

# 2. Launch floating impala window
kitty --class="$CLASS" -e impala &

# 3. Wait until the window is created
while [ -z "$addr" ]; do
  addr=$(hyprctl clients -j | jq -r ".[] | select(.class == \"$CLASS\") | .address")
  sleep 0.05
done

# Focus the window
hyprctl dispatch focuswindow address:"$addr"

# Brief grace period to ensure focus is grabbed
sleep 0.4

# 4. Event-driven close: wait until another window or workspace is focused
socat -u "UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" - | while read -r line; do
  case "$line" in
  activewindowv2*)
    new_addr="0x${line#*>>}"
    if [ "$new_addr" != "$addr" ]; then
      hyprctl dispatch closewindow address:"$addr"
      break
    fi
    ;;
  esac
done
